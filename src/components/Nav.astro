---
import { categories } from '../data/categories';
import { site } from '../data/site';

interface Props {
  sheet: string;
}
const { sheet } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav" data-nav>
  <a href="/" class="nav-name mono u-link" aria-current={path === '/' ? 'page' : undefined} data-cursor="Home">
    {site.short}
  </a>
  <span class="nav-sheet mono muted" aria-hidden="true">Sheet {sheet}</span>
  <nav class="nav-links" aria-label="Primary">
    <ul>
      {
        categories.map((c) => (
          <li>
            <a
              href={c.href}
              class:list={['mono', 'u-link', { soon: c.status === 'in-progress' }]}
              aria-current={path === c.href ? 'page' : undefined}
            >
              {c.short}
              {c.status === 'in-progress' && <sup class="soon-tag">soon</sup>}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <button class="nav-toggle mono" aria-expanded="false" aria-controls="menu" data-menu-toggle>
    <span class="t-open">Menu</span><span class="t-close">Close</span>
  </button>
</header>

<div class="menu" id="menu" data-menu hidden>
  <ol>
    {
      categories.map((c) => (
        <li>
          <a href={c.href} class:list={{ soon: c.status === 'in-progress' }}>
            <span class="mono muted">{c.number}</span>
            <span class="menu-name">{c.name}</span>
            {c.status === 'in-progress' && <span class="mono muted">In progress</span>}
          </a>
        </li>
      ))
    }
  </ol>
  <p class="mono muted menu-foot">{site.program} · {site.department} · {site.section}</p>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: var(--nav-h);
    padding-inline: var(--margin);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    mix-blend-mode: difference;
    color: #fff;
    transition: transform 0.6s var(--ease-draft);
  }
  .nav.is-hidden {
    transform: translateY(-100%);
  }
  .nav-name {
    justify-self: start;
    font-weight: 500;
  }
  .nav-sheet {
    color: rgba(255, 255, 255, 0.55);
  }
  .nav-links {
    justify-self: end;
  }
  .nav-links ul {
    display: flex;
    gap: clamp(18px, 3vw, 44px);
    list-style: none;
    padding: 0;
  }
  .soon {
    color: rgba(255, 255, 255, 0.5);
  }
  .soon-tag {
    margin-left: 4px;
    font-size: 0.75em;
    vertical-align: super;
    letter-spacing: 0.04em;
  }
  .nav-toggle {
    display: none;
    justify-self: end;
    padding: 10px 0;
  }
  .t-close {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] .t-open {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] .t-close {
    display: inline;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 59;
    background: var(--ink);
    padding: calc(var(--nav-h) + 24px) var(--margin) var(--margin);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .menu[hidden] {
    display: none;
  }
  .menu ol {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .menu li {
    border-bottom: 1px solid var(--line);
  }
  .menu a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    align-items: baseline;
    gap: 4px 0;
    padding: 18px 0;
  }
  .menu a > .mono:last-child:not(:first-child) {
    grid-column: 2;
  }
  .menu-name {
    font-size: clamp(1.8rem, 8vw, 3rem);
    font-weight: 280;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .menu a.soon .menu-name {
    color: var(--stone);
  }

  @media (max-width: 860px) {
    .nav {
      grid-template-columns: 1fr auto;
    }
    .nav-sheet,
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: block;
    }
  }
</style>

<script>
  import { lenis, lockScroll } from '../scripts/motion';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  // Hide the bar while scrolling down, bring it back when scrolling up.
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    if (!menu.hidden) return;
    nav.classList.toggle('is-hidden', y > lastY && y > 160);
    lastY = y;
  };
  if (lenis) lenis.on('scroll', onScroll);
  else window.addEventListener('scroll', onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    nav.style.mixBlendMode = open ? 'normal' : '';
    lockScroll(open);
    document.documentElement.classList.remove('dialog-open');
    if (open) menu.querySelector('a')?.focus();
  };
  toggle.addEventListener('click', () => setMenu(menu.hidden));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setMenu(false);
      toggle.focus();
    }
  });
</script>
