---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Cursor from '../components/Cursor.astro';
import Curtain from '../components/Curtain.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Drawing sheet number shown in the nav and title block, e.g. "A-101". */
  sheet: string;
  sheetTitle: string;
}

const { title, description = site.description, sheet, sheetTitle } = Astro.props;
const fullTitle = title ? `${title} — ${site.short}` : `${site.short} — Architecture Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b0a09" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Set motion / preloader / curtain state before first paint to avoid flashes. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        d.classList.add('motion');
        try {
          if (sessionStorage.getItem('curtain') === '1') {
            d.classList.add('curtain-cover');
            sessionStorage.removeItem('curtain');
          }
          if (!sessionStorage.getItem('seen') && d.dataset.preload !== 'off' && location.pathname === '/') {
            d.classList.add('is-loading');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip mono" href="#main">Skip to content</a>
    <div class="sheet-grid" aria-hidden="true">
      {Array.from({ length: 12 }, () => <span />)}
    </div>
    <slot name="preloader" />
    <Nav sheet={sheet} />
    <main id="main">
      <slot />
    </main>
    <TitleBlock sheet={sheet} sheetTitle={sheetTitle} />
    <Cursor />
    <Curtain />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 10px 14px;
    background: var(--paper);
    color: var(--ink);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
</style>

<script>
  import '../scripts/motion';
</script>
